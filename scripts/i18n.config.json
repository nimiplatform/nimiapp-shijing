{
  "supportedLocales": [
    "en",
    "zh"
  ],
  "audit": {
    "scopeDirs": [
      "src/shell",
      "src/product"
    ],
    "extensions": [
      ".ts",
      ".tsx"
    ],
    "excludePathPatterns": [
      "/test/",
      ".test.",
      ".spec.",
      "src/shell/locales/",
      "src/product/i18n/",
      "src/product/astrology/",
      "src/product/conversations/conversation-chat-bridge.ts",
      "src/product/concern-tags/concern-presets.ts",
      "src/product/datetime/friendly-time.ts",
      "src/product/tabs/shared/method-evidence-chips.ts"
    ],
    "knownDebtPathPatterns": [],
    "allowTextPatterns": [
      "^-$",
      "^--$",
      "^x$",
      "^X$",
      "^Nimi$",
      "^ShiJing$",
      "^SHIJING$",
      "^Runtime$",
      "^Runtime AI$",
      "^AI$",
      "^ULID$",
      "^UTC$",
      "^GMT$",
      "^IANA$",
      "^JSON$",
      "^[A-Z0-9_]+$",
      "^[0-9]+$",
      "^[0-9]+/[0-9]+$",
      "^[a-z][a-z0-9]*(?:_[a-z0-9]+)+$",
      "^(high|medium|low|active|archived|manual|rijing|yuejing|nianjing|shijing)$",
      "^中$",
      "^SHIJING · OS$",
      "^T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    ],
    "nonUiSources": {
      "src/shell/infra/renderer-log.ts": "Diagnostic log metadata, not renderer copy.",
      "src/shell/app-shell/runtime-access-state.ts": "Owner error and session evidence; reason and action text must be preserved.",
      "src/product/dev/": "Explicit preview/test data and user-authored sample records, never installed account truth.",
      "src/product/conversations/shijing-answer-format.ts": "Structured-answer parsing labels and field aliases, not UI translations."
    }
  }
}
