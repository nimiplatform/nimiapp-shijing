{
  "name": "nimiapp-shijing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1430 --strictPort",
    "dev:electron": "nimi-app dev --shell electron",
    "dev:shell": "nimi-app dev",
    "tauri": "tauri",
    "build:renderer": "vite build",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck": "pnpm run typecheck:renderer && pnpm run typecheck:electron",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "build": "pnpm run typecheck && pnpm run build:renderer && (cd src-tauri && cargo check)",
    "build:shell": "tauri build",
    "lint": "pnpm run i18n:check && pnpm run i18n:audit && pnpm run typecheck && eslint . --max-warnings 0 && (cd src-tauri && cargo check)",
    "test": "node --test test/*.test.mjs test/golden/*.test.mjs",
    "sync": "nimi-app sync",
    "validate": "node scripts/validate.mjs",
    "local-audit": "node scripts/local-audit.mjs",
    "app:build": "nimi-app build",
    "pack": "nimi-app pack",
    "check:platform": "nimi-app check",
    "check": "pnpm run check:platform && pnpm run validate && pnpm run local-audit && pnpm run typecheck && pnpm run test && pnpm run lint",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "nimicoding": "nimicoding",
    "nimicoding:doctor": "nimicoding doctor",
    "spec:authority:check": "nimicoding authority check .nimi/spec",
    "spec:authority:compile": "nimicoding authority compile .nimi/spec",
    "eval:wording": "node scripts/wording-eval/run.mjs",
    "eval:wording:score": "node scripts/wording-eval/score.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.1",
    "astronomy-engine": "^2.1.19",
    "i18next": "^25.10.10",
    "iztro": "^2.5.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.6.6",
    "tyme4ts": "^1.5.0",
    "zustand": "^5.0.13",
    "@nimiplatform/sdk": "^0.7.0",
    "@nimiplatform/kit": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "42.5.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.6",
    "yaml": "^2.9.0",
    "@nimiplatform/app-tools": "^0.2.1",
    "@nimiplatform/nimi-coding": "0.6.1"
  },
  "author": "Nimi Team",
  "license": "MIT"
}
