{
  "name": "nimiapp-shijing",
  "version": "0.1.11",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nimi-app dev --shell electron",
    "dev:renderer": "vite --host 127.0.0.1 --port 1430 --strictPort",
    "dev:electron": "nimi-app dev --shell electron",
    "dev:shell": "nimi-app dev",
    "build:renderer": "vite build",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck": "pnpm run typecheck:renderer && pnpm run typecheck:electron",
    "build:electron": "tsc -p tsconfig.electron.json && node scripts/bundle-electron-preload.mjs",
    "build:electron:production": "node scripts/clean-electron-production.mjs && pnpm run build && node scripts/package-electron-production.mjs",
    "build": "pnpm run typecheck && pnpm run build:renderer && pnpm run build:electron",
    "lint": "pnpm run i18n:check && pnpm run i18n:audit && pnpm run typecheck && eslint . --max-warnings 0",
    "test": "node --test test/*.test.mjs test/golden/*.test.mjs",
    "test:browser": "node --test test/browser/*.test.mjs",
    "sync": "nimi-app sync",
    "validate": "node scripts/validate.mjs",
    "local-audit": "node scripts/local-audit.mjs",
    "app:build": "nimi-app build",
    "pack": "nimi-app pack",
    "check:platform": "nimi-app check",
    "check": "pnpm run check:platform && pnpm run validate && pnpm run local-audit && pnpm run typecheck && pnpm run test && pnpm run lint",
    "i18n:check": "node scripts/i18n-check.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "nimicoding": "nimicoding",
    "nimicoding:doctor": "nimicoding doctor",
    "spec:authority:check": "nimicoding authority check .nimi/spec",
    "spec:authority:compile": "nimicoding authority compile .nimi/spec",
    "eval:wording": "node scripts/wording-eval/run.mjs",
    "eval:wording:score": "node scripts/wording-eval/score.mjs",
    "postinstall": "install-electron",
    "dev:web": "nimi-app dev --platform web",
    "dev:web-renderer": "vite --config vite.web.config.ts --mode web",
    "build:web": "pnpm run typecheck:renderer && vite build --config vite.web.config.ts --mode web",
    "build:web:release": "pnpm run typecheck:renderer && vite build --config vite.web.config.ts --mode web-release",
    "build:mobile": "pnpm run typecheck:renderer && vite build --config vite.mobile.config.ts",
    "sync:android": "pnpm run build:mobile && cap sync android",
    "dev:android": "pnpm run sync:android && cap run android --no-sync",
    "dev:mobile": "nimi-app dev --platform mobile"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@nimiplatform/kit": "^0.23.1-rc.1",
    "@nimiplatform/sdk": "^0.23.1-rc.1",
    "astronomy-engine": "^2.1.19",
    "i18next": "^26.4.2",
    "iztro": "^2.5.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.0",
    "tyme4ts": "^1.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@electron/packager": "^20.3.0",
    "@eslint/js": "^10.0.1",
    "@nimiplatform/app-tools": "^0.15.1-rc.1",
    "@nimiplatform/nimi-coding": "0.7.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.3.3",
    "yaml": "^2.9.0"
  },
  "author": "Nimi Team",
  "license": "MIT"
}
